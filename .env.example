# ===== LLM provider (NO KEY REQUIRED) =====
# auto -> Claude if ANTHROPIC_API_KEY set, else Ollama if running, else heuristic (pure Python, zero cost)
LLM_PROVIDER=auto

# Option A: paid, best quality
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6          # use claude-opus-4-8 for deep analysis

# Option B: FREE local AI (no key). Install https://ollama.com then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option C: nothing set -> heuristic mode. Scrapers + rule-based analysis. Works out of the box.

# ===== Optional answer-engine probes (AEO agent) =====
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# ===== Agent service =====
AGENTS_PORT=8000
AGENTS_BASE_URL=http://agents:8000        # web -> agents (docker network name)
SCRAPER_TIMEOUT=30
SCRAPER_USER_AGENT=AEOBot/0.1 (+https://example.com/bot)

# ===== Database (web) =====
POSTGRES_USER=aeo
POSTGRES_PASSWORD=aeo
POSTGRES_DB=aeo
DATABASE_URL=postgresql://aeo:aeo@postgres:5432/aeo?schema=public

# ===== Web =====
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME=AEO Platform
