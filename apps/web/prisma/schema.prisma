generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single agent execution + its result.
model Run {
  id              String   @id @default(cuid())
  agent           String // aeo | seo | competitor
  input           Json
  status          String   @default("completed") // queued | running | completed | failed
  summary         String?
  score           Float?
  findings        Json?
  recommendations Json?
  raw             Json?
  error           String?
  createdAt       DateTime @default(now())
  finishedAt      DateTime?

  @@index([agent, createdAt])
}
